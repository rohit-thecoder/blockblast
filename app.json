{
  "expo": {
    "name": "Block Blast Puzzle",
    "slug": "block-blast-puzzle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "scheme": "blockblastpuzzle",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.infineticstudios.blockblast"
    },
    "android": {
      "package": "com.infineticstudios.blockblast",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4B62B8"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-audio",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#4B62B8"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4B62B8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bebe05da-afae-4a1f-b4ae-d621ed884504"
      }
    }
  }
}
